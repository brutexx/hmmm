/// @namespace http://www.semanticweb.org/bruno-vitor/ontologies/2026/11/hmmm#
ontology hmmm


/// Uma pessoa que joga Minecraft em um mundo.
kind Jogador

/// Um bloco que um aldeão pode reivindicar como seu local de trabalho,
/// como o defumador ou o suporte de poções.
kind BlocoDeTrabalho {
    @instantiation [0..*] -- [1] (const) TipoDeBlocoDeTrabalho
}

/// Um tipo de bloco de trabalho, como o defumador ou o suporte de poções.
///
/// As instâncias são os tipos de bloco, e não os blocos colocados no mundo.
type TipoDeBlocoDeTrabalho

/// Um bloco de trabalho em que um aldeão se torna açougueiro.
subkind Defumador (instanceOf TipoDeBlocoDeTrabalho) specializes BlocoDeTrabalho
/// Um bloco de trabalho em que um aldeão se torna clérigo.
subkind SuporteDePocoes (instanceOf TipoDeBlocoDeTrabalho) specializes BlocoDeTrabalho
disjoint genset tipoDeBloco {
    general BlocoDeTrabalho
    categorizer TipoDeBlocoDeTrabalho
    specifics Defumador, SuporteDePocoes
}

kind Aldeao

phase AldeaoBebe specializes Aldeao
/// Um aldeão que já cresceu.
///
/// Um aldeão adulto não volta a ser bebê.
phase AldeaoAdulto specializes Aldeao
disjoint complete genset estagiosDaVida
    where AldeaoBebe, AldeaoAdulto specializes Aldeao

phase AldeaoSaudavel specializes Aldeao
phase AldeaoZumbi specializes Aldeao
disjoint complete genset saúde
    where AldeaoSaudavel, AldeaoZumbi specializes Aldeao

/// Uma profissão de aldeão, como açougueiro ou clérigo.
type Profissao

/// Uma profissão só é exercida por meio de um bloco de trabalho do seu tipo:
/// o açougueiro, pelo defumador; o clérigo, pelo suporte de poções.
relation Profissao [1] -- dependeDe -- [1] TipoDeBlocoDeTrabalho

/// Um aldeão que exerce uma profissão.
roleMixin AldeaoEmpregado of functional-complexes {
    /// A profissão que o aldeão exerce.
    @instantiation [0..*] -- [1] (const) Profissao
    /// Os pontos de experiência que o aldeão acumulou negociando.
    experiencia: number
    /// O nível que o aldeão alcançou na profissão. Decorre da experiência:
    /// Aprendiz a partir de 10 pontos, Qualificado a partir de 70, Experiente
    /// a partir de 150 e Mestre a partir de 250.
    nivel: NivelDeProfissao
}

/// Um aldeão empregado que reivindica um bloco de trabalho.
role AldeaoEmpregadoComBloco specializes Aldeao, AldeaoEmpregado

/// Um aldeão só é empregado enquanto reivindica um bloco ou depois de ter
/// negociado. Os dois casos podem valer ao mesmo tempo.
complete genset sustentacaoDoEmprego
    where AldeaoEmpregadoComBloco, AldeaoComProfissaoFixada specializes AldeaoEmpregado

/// A ligação entre um aldeão empregado e o bloco de trabalho que ele reivindicou.
///
/// Cada aldeão reivindica no máximo um bloco, e cada bloco é reivindicado
/// por no máximo um aldeão.
relator Reivindicacao {
    @mediation [1] -- [1] (const) AldeaoEmpregadoComBloco
    @mediation [0..1] -- [1] (const) BlocoDeTrabalho
}

/// Um aldeão empregado como açougueiro, profissão ligada ao defumador.
role Açougueiro (instanceOf Profissao) specializes Aldeao, AldeaoEmpregado
/// Um aldeão empregado como clérigo, profissão ligada ao suporte de poções.
role Clérigo (instanceOf Profissao) specializes Aldeao, AldeaoEmpregado
disjoint genset profissão {
    general AldeaoEmpregado
    categorizer Profissao
    specifics Açougueiro, Clérigo
}

/// Um jogador e um aldeão negociaram: o jogador entregou os itens pedidos
/// e recebeu o item oferecido.
event Troca

/// Um aldeão negociou com um jogador.
@participation relation Aldeao (const) [1] -- negociouEm -- [0..*] (addOnly) Troca
/// Um jogador negociou com um aldeão.
@participation relation Jogador (const) [1] -- negociouEm -- [0..*] (addOnly) Troca

/// Um aldeão empregado que já negociou ao menos uma vez.
///
/// Só um aldeão empregado negocia, e a primeira troca fixa a profissão dele:
/// o emprego não termina mais, nem se o bloco de trabalho for destruído.
historicalRole AldeaoComProfissaoFixada specializes Aldeao, AldeaoEmpregado derivedFrom Aldeao.negociouEm

/// Um tipo de item do jogo, como esmeralda, trigo ou livro encantado.
///
/// As instâncias são os tipos de item, e não os itens que estão no
/// inventário de alguém.
type TipoDeItem

/// Um dos cinco níveis que um aldeão empregado alcança ganhando experiência.
enum NivelDeProfissao {
    Novato,
    Aprendiz,
    Qualificado,
    Experiente,
    Mestre
}

/// Uma troca que o jogo prevê para uma profissão em um nível, como 
/// "O Agricultor Novato compra 20 trigos por uma esmeralda".
///
/// As instâncias são os tipos de oferta. 
/// Cada oferta de um aldeão é de um desses tipos.
type TipoDeOferta {
    /// O nível a partir do qual um aldeão da profissão pode ter esta oferta.
    nivel: const NivelDeProfissao
    /// Quantas vezes uma oferta deste tipo pode ser usada antes de esgotar.
    usosMaximos: const number
    /// Quanto de experiência o aldeão ganha a cada troca feita por meio de
    /// uma oferta deste tipo.
    experienciaConcedida: const number
}

/// A profissão cujos aldeões podem ter ofertas deste tipo.
relation TipoDeOferta [0..*] -- pertenceA -- [1] Profissao
/// O primeiro item que o aldeão pede.
relation TipoDeOferta [0..*] -- pede -- [1] TipoDeItem
/// O segundo item que o aldeão pede, quando há.
relation TipoDeOferta [0..*] -- pedeTambem -- [0..1] TipoDeItem
/// O item que o aldeão entrega.
relation TipoDeOferta [0..*] -- oferece -- [1] TipoDeItem

/// A disposição de um aldeão empregado de fazer uma troca com qualquer
/// jogador: entregar um item em troca dos itens que pede.
///
/// Ao alcançar cada nível, o aldeão sorteia até duas ofertas entre os tipos
/// daquele nível para a sua profissão, e mantém as que já tinha. O tipo da
/// oferta é da profissão do aldeão e de um nível que ele já alcançou.
intrinsicMode OfertaDeTroca {
    // characterization porque é uma feature instrínseca do seu "bearer",
    // que é o aldeão empregado. 
    @characterization [0..*] -- [1] (const) AldeaoEmpregado
    @instantiation [0..*] -- [1] (const) TipoDeOferta
    /// Quantos itens do primeiro tipo o aldeão pede, antes de descontos e demanda.
    quantidadePedida: const number
    /// Quantos itens do segundo tipo o aldeão pede, quando há.
    quantidadePedidaTambem: const number [0..1]
    /// Quantos itens o aldeão entrega.
    quantidadeOferecida: const number
    /// Quantas vezes a oferta foi usada desde o último reabastecimento.
    usos: number
}

/// Uma troca aconteceu por meio desta oferta, com o aldeão que a tem.
@manifestation relation OfertaDeTroca (const) [1] -- manifestouSeEm -- [0..*] (addOnly) Troca