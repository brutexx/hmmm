#################################################################
#    Mundo de teste
#################################################################

mundo:steve a hmmm:Jogador ;
    rdfs:label "Steve" .

mundo:defumador-1 a hmmm:BlocoDeTrabalho ;
    rdfs:label "Defumador perto do sino" .

# Um açougueiro novato que ainda não negociou: o emprego se sustenta pela
# reivindicação do defumador. Sorteou 2 das 4 ofertas de Novato.

mundo:aldeao-1 a hmmm:Açougueiro, hmmm:AldeaoEmpregadoComBloco,
        hmmm:AldeaoAdulto, hmmm:AldeaoSaudavel ;
    rdfs:label "Açougueiro novato" ;
    hmmm:AldeaoEmpregado.experiencia 0 ;
    hmmm:AldeaoEmpregado.nivel hmmm:NivelDeProfissao.Novato .

mundo:emprego-1 a hmmm:Emprego ;
    hmmm:Emprego.mediatesAldeaoEmpregado mundo:aldeao-1 ;
    hmmm:Emprego.mediatesProfissao hmmm:Açougueiro .

mundo:reivindicacao-1 a hmmm:Reivindicacao ;
    hmmm:Reivindicacao.mediatesAldeaoEmpregadoComBloco mundo:aldeao-1 ;
    hmmm:Reivindicacao.mediatesBlocoDeTrabalho mundo:defumador-1 .

mundo:oferta-1-1 a hmmm:OfertaDeTroca, tipo:butcher-1-chicken-emerald ;
    hmmm:OfertaDeTroca.inheresInAldeaoEmpregado mundo:aldeao-1 ;
    hmmm:OfertaDeTroca.quantidadePedida 14 ;
    hmmm:OfertaDeTroca.quantidadeOferecida 1 ;
    hmmm:OfertaDeTroca.usos 0 .

mundo:oferta-1-2 a hmmm:OfertaDeTroca, tipo:butcher-1-emerald-rabbit_stew ;
    hmmm:OfertaDeTroca.inheresInAldeaoEmpregado mundo:aldeao-1 ;
    hmmm:OfertaDeTroca.quantidadePedida 1 ;
    hmmm:OfertaDeTroca.quantidadeOferecida 1 ;
    hmmm:OfertaDeTroca.usos 0 .

# Um clérigo aprendiz que já negociou e perdeu o suporte de poções: o
# emprego se sustenta pela profissão fixada. Fez 5 trocas de carne podre e
# 12 de redstone (5 x 2 + 12 x 1 = 22 pontos de experiência). A oferta de
# redstone está esgotada.

mundo:aldeao-2 a hmmm:Clérigo, hmmm:AldeaoComProfissaoFixada,
        hmmm:AldeaoAdulto, hmmm:AldeaoSaudavel ;
    rdfs:label "Clérigo aprendiz" ;
    hmmm:AldeaoEmpregado.experiencia 22 ;
    hmmm:AldeaoEmpregado.nivel hmmm:NivelDeProfissao.Aprendiz .

mundo:emprego-2 a hmmm:Emprego ;
    hmmm:Emprego.mediatesAldeaoEmpregado mundo:aldeao-2 ;
    hmmm:Emprego.mediatesProfissao hmmm:Clérigo .

mundo:oferta-2-1 a hmmm:OfertaDeTroca, tipo:cleric-1-rotten_flesh-emerald ;
    hmmm:OfertaDeTroca.inheresInAldeaoEmpregado mundo:aldeao-2 ;
    hmmm:OfertaDeTroca.quantidadePedida 32 ;
    hmmm:OfertaDeTroca.quantidadeOferecida 1 ;
    hmmm:OfertaDeTroca.usos 5 .

mundo:oferta-2-2 a hmmm:OfertaDeTroca, tipo:cleric-1-emerald-redstone ;
    hmmm:OfertaDeTroca.inheresInAldeaoEmpregado mundo:aldeao-2 ;
    hmmm:OfertaDeTroca.quantidadePedida 1 ;
    hmmm:OfertaDeTroca.quantidadeOferecida 2 ;
    hmmm:OfertaDeTroca.usos 12 .

mundo:oferta-2-3 a hmmm:OfertaDeTroca, tipo:cleric-2-gold_ingot-emerald ;
    hmmm:OfertaDeTroca.inheresInAldeaoEmpregado mundo:aldeao-2 ;
    hmmm:OfertaDeTroca.quantidadePedida 3 ;
    hmmm:OfertaDeTroca.quantidadeOferecida 1 ;
    hmmm:OfertaDeTroca.usos 0 .

mundo:oferta-2-4 a hmmm:OfertaDeTroca, tipo:cleric-2-emerald-lapis_lazuli ;
    hmmm:OfertaDeTroca.inheresInAldeaoEmpregado mundo:aldeao-2 ;
    hmmm:OfertaDeTroca.quantidadePedida 1 ;
    hmmm:OfertaDeTroca.quantidadeOferecida 1 ;
    hmmm:OfertaDeTroca.usos 0 .

# Uma das trocas de carne podre entre Steve e o clérigo.

mundo:troca-1 a hmmm:Troca .

mundo:aldeao-2 hmmm:Aldeao.negociouEm mundo:troca-1 .
mundo:steve hmmm:Jogador.negociouEm mundo:troca-1 .
mundo:oferta-2-1 hmmm:OfertaDeTroca.manifestouSeEm mundo:troca-1 .
