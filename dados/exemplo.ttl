# Dados de teste para experimentar as consultas antes de
# existirem os scripts de importação.
#
# Catálogo: todas as ofertas do açougueiro e do clérigo na Java Edition,
# segundo a Minecraft Wiki (https://minecraft.wiki/w/Trading).
# Mundo: dois aldeões, um jogador e uma troca inventados.
#
# Os IRIs de itens usam o identificador do jogo (minecraft:chicken -> item:chicken).
# Os tipos de oferta seguem <profissão>-<nível>-<item pedido>-<item oferecido>.

@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix hmmm:  <http://www.semanticweb.org/bruno-vitor/ontologies/2026/11/hmmm#> .
@prefix item:  <http://www.semanticweb.org/bruno-vitor/ontologies/2026/11/hmmm/dados/item/> .
@prefix tipo:  <http://www.semanticweb.org/bruno-vitor/ontologies/2026/11/hmmm/dados/tipo-de-oferta/> .
@prefix mundo: <http://www.semanticweb.org/bruno-vitor/ontologies/2026/11/hmmm/dados/mundo-teste/> .

#################################################################
#    Tipos de item
#################################################################

item:emerald            a hmmm:TipoDeItem ; rdfs:label "Esmeralda"@pt-br .
item:chicken            a hmmm:TipoDeItem ; rdfs:label "Frango cru"@pt-br .
item:rabbit             a hmmm:TipoDeItem ; rdfs:label "Coelho cru"@pt-br .
item:porkchop           a hmmm:TipoDeItem ; rdfs:label "Costeleta de porco crua"@pt-br .
item:rabbit_stew        a hmmm:TipoDeItem ; rdfs:label "Ensopado de coelho"@pt-br .
item:coal               a hmmm:TipoDeItem ; rdfs:label "Carvão"@pt-br .
item:cooked_chicken     a hmmm:TipoDeItem ; rdfs:label "Frango assado"@pt-br .
item:cooked_porkchop    a hmmm:TipoDeItem ; rdfs:label "Costeleta de porco assada"@pt-br .
item:beef               a hmmm:TipoDeItem ; rdfs:label "Carne bovina crua"@pt-br .
item:mutton             a hmmm:TipoDeItem ; rdfs:label "Carne de carneiro crua"@pt-br .
item:dried_kelp_block   a hmmm:TipoDeItem ; rdfs:label "Bloco de alga seca"@pt-br .
item:sweet_berries      a hmmm:TipoDeItem ; rdfs:label "Bagas doces"@pt-br .
item:rotten_flesh       a hmmm:TipoDeItem ; rdfs:label "Carne podre"@pt-br .
item:redstone           a hmmm:TipoDeItem ; rdfs:label "Pó de redstone"@pt-br .
item:gold_ingot         a hmmm:TipoDeItem ; rdfs:label "Barra de ouro"@pt-br .
item:lapis_lazuli       a hmmm:TipoDeItem ; rdfs:label "Lápis-lazúli"@pt-br .
item:rabbit_foot        a hmmm:TipoDeItem ; rdfs:label "Pé de coelho"@pt-br .
item:glowstone          a hmmm:TipoDeItem ; rdfs:label "Pedra luminosa"@pt-br .
item:turtle_scute       a hmmm:TipoDeItem ; rdfs:label "Escama de tartaruga"@pt-br .
item:glass_bottle       a hmmm:TipoDeItem ; rdfs:label "Frasco de vidro"@pt-br .
item:ender_pearl        a hmmm:TipoDeItem ; rdfs:label "Pérola do End"@pt-br .
item:nether_wart        a hmmm:TipoDeItem ; rdfs:label "Fungo do Nether"@pt-br .
item:experience_bottle  a hmmm:TipoDeItem ; rdfs:label "Frasco de experiência"@pt-br .

#################################################################
#    Tipos de oferta (catálogo do jogo)
#################################################################
#
# Cada tipo de oferta é instância de hmmm:TipoDeOferta e também uma classe
# cujas instâncias são as ofertas concretas dos aldeões. O modelo ainda não
# tem as quantidades no tipo de oferta; elas estão nos comentários.

# Açougueiro, Novato

# 14 frangos crus -> 1 esmeralda
tipo:butcher-1-chicken-emerald a hmmm:TipoDeOferta, owl:Class ;
    rdfs:subClassOf hmmm:OfertaDeTroca ;
    hmmm:TipoDeOferta.pertenceA hmmm:Açougueiro ;
    hmmm:TipoDeOferta.nivel hmmm:NivelDeProfissao.Novato ;
    hmmm:TipoDeOferta.pede item:chicken ;
    hmmm:TipoDeOferta.oferece item:emerald ;
    hmmm:TipoDeOferta.usosMaximos 16 ;
    hmmm:TipoDeOferta.experienciaConcedida 2 .

# 4 coelhos crus -> 1 esmeralda
tipo:butcher-1-rabbit-emerald a hmmm:TipoDeOferta, owl:Class ;
    rdfs:subClassOf hmmm:OfertaDeTroca ;
    hmmm:TipoDeOferta.pertenceA hmmm:Açougueiro ;
    hmmm:TipoDeOferta.nivel hmmm:NivelDeProfissao.Novato ;
    hmmm:TipoDeOferta.pede item:rabbit ;
    hmmm:TipoDeOferta.oferece item:emerald ;
    hmmm:TipoDeOferta.usosMaximos 16 ;
    hmmm:TipoDeOferta.experienciaConcedida 2 .

# 7 costeletas de porco cruas -> 1 esmeralda
