    hmmm:TipoDeOferta.pertenceA hmmm:Açougueiro ;
    hmmm:TipoDeOferta.nivel hmmm:NivelDeProfissao.Novato ;
    hmmm:TipoDeOferta.pede item:porkchop ;
    hmmm:TipoDeOferta.oferece item:emerald ;
    hmmm:TipoDeOferta.usosMaximos 16 ;
    hmmm:TipoDeOferta.experienciaConcedida 2 .

# 1 esmeralda -> 1 ensopado de coelho
tipo:butcher-1-emerald-rabbit_stew a hmmm:TipoDeOferta, owl:Class ;
    rdfs:subClassOf hmmm:OfertaDeTroca ;
    hmmm:TipoDeOferta.pertenceA hmmm:Açougueiro ;
